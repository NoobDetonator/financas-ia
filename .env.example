# Copie este arquivo para .env e preencha.
#
# O .env NUNCA vai para o repositorio (esta no .gitignore) porque guarda a
# chave da API de IA e a senha de acesso ao sistema.
#
# O jeito facil: rode CONFIGURAR.bat, que cria o .env e gera o SESSION_SECRET.

# ── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3333
# 127.0.0.1 = so este PC. 0.0.0.0 = acessivel na rede local (celular no Wi-Fi).
HOST=127.0.0.1
LOG_LEVEL=info

# ── Banco de dados ──────────────────────────────────────────────────────────
DATABASE_PATH=./data/finance.db

# ── Autenticacao (usuario unico) ────────────────────────────────────────────
# Senha de acesso. Gere o segredo de sessao com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PASSWORD=troque-esta-senha
SESSION_SECRET=
# Deixe em true apenas enquanto roda somente em 127.0.0.1 sem expor na rede.
AUTH_DISABLED=false

# ── IA (DeepSeek) ───────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-chat

# ── Timezone / locale ───────────────────────────────────────────────────────
TZ=America/Sao_Paulo
