{
  "name": "financas",
  "version": "0.1.0",
  "description": "Controle de financas pessoais com IA integrada.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev:api",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"tests/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "chat": "tsx src/cli/chat.ts",
    "dev:api": "tsx watch src/main.ts",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "web:install": "npm --prefix web install"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.13",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.8.1",
    "@scalar/fastify-api-reference": "^1.63.0",
    "ai": "^7.0.37",
    "better-sqlite3": "~12.6.2",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "fastify": "^5.10.0",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "node-cron": "^4.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
